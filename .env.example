# Copy to .env and adjust for your environment
PORT=3000
API_PREFIX=api
API_VERSION=1
NODE_ENV=development

# Frontend origin for CORS (dev)
FRONTEND_URL=http://localhost:3000

# Local dev: mongodb://localhost:27017/microfin-memory-game
# Docker compose: mongodb://mongo:27017/microfin-memory-game
MONGODB_URI=mongodb://localhost:27017/microfin-memory-game

# Local dev: redis://localhost:6379
# Docker compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Redis lock (optional)
REDIS_LOCK_DRIFT_FACTOR=0.01
REDIS_LOCK_RETRY_JITTER=200
REDIS_LOCK_RETRY_COUNT=5
REDIS_LOCK_RETRY_DELAY=200
