# ============================================================
# Dành cho setup TOÀN DOCKER: backend + mongo + redis đều trong docker compose.
# Copy sang file .env.docker (đã được docker-compose.yml đọc trực tiếp)
# ============================================================
PORT=3000
API_PREFIX=api
API_VERSION=1
NODE_ENV=production

# Frontend origin (thay bằng domain FE khi deploy)
FRONTEND_URL=http://localhost:3000

# Mongo chạy trong docker compose -> dùng hostname service "mongo"
MONGODB_URI=mongodb://mongo:27017/microfin-memory-game

# Redis chạy trong docker compose -> dùng hostname service "redis"
REDIS_URL=redis://redis:6379

# Admin đăng nhập (dùng chung JWT secret với FE admin)
BETTER_AUTH_SECRET=secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Redis lock (optional)
REDIS_LOCK_DRIFT_FACTOR=0.01
REDIS_LOCK_RETRY_JITTER=200
REDIS_LOCK_RETRY_COUNT=5
REDIS_LOCK_RETRY_DELAY=200
